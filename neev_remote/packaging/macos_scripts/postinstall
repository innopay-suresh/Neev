#!/bin/bash
# Install the host daemon as part of the package — never as a step the user has
# to find.
#
# Before this, the .pkg dropped NeevRemote.app in /Applications and stopped.
# TransportMode (the service that hosts across a user switch and at the login
# window, and that shows the host's session controls) had to be installed by
# hand from Settings. Anyone who missed it got an app that looked installed and
# silently lacked half its features — including any host-side session UI, which
# is exactly how "the app isn't working" reports start.
#
# The installer already runs as root, so this needs no extra prompt.
set -uo pipefail

LOG="/var/log/neev-remote-install.log"
log() { echo "$(date -u '+%Y-%m-%dT%H:%M:%SZ') $*" >>"$LOG" 2>/dev/null || true; }

log "postinstall starting (target=${2:-unset})"

# Find the installed app rather than assuming where it landed.
#
# This used to hardcode /Applications/NeevRemote.app and reported "no daemon
# payload" on a package that demonstrably contained one — the lookup was wrong,
# not the build. Installer scripts receive the install location in $2, and the
# bundle name can change, so search for the bundle that actually carries the
# daemon instead of guessing its path.
DEST="${2:-/Applications}"
APP=""
for candidate in \
  "$DEST/NeevRemote.app" \
  "/Applications/NeevRemote.app" \
  $(find "$DEST" -maxdepth 2 -name "*.app" -type d 2>/dev/null) \
  $(find /Applications -maxdepth 2 -name "*.app" -type d 2>/dev/null); do
  [ -d "$candidate/Contents/Resources/daemon" ] || continue
  APP="$candidate"
  break
done

if [ -z "$APP" ]; then
  # FAIL the install rather than logging into a file nobody reads.
  #
  # This condition occurred four times in a row on a real machine while
  # `installer` printed "The upgrade was successful" each time — the app was not
  # on disk at all, and nothing surfaced that. A package that cannot configure
  # what it just installed has not installed anything useful, and saying so is
  # the only way the user finds out at the moment they can act on it.
  log "FAILED: no installed app bundle containing Contents/Resources/daemon"
  log "  looked under: $DEST and /Applications"
  echo "Neev Remote: the application was not found after installation." >&2
  echo "  Looked under $DEST and /Applications." >&2
  echo "  If an older copy was deleted, clear its receipt and install again:" >&2
  echo "    sudo pkgutil --forget com.neev.neev_remote" >&2
  exit 1
fi
log "found app bundle: $APP"

DAEMON_DIR="$APP/Contents/Resources/daemon"
AGENT="$DAEMON_DIR/neev-agent"
INSTALLER="$DAEMON_DIR/install-daemon.sh"

# Gatekeeper quarantine on a freshly copied bundle stops launchd running it.
if command -v xattr >/dev/null 2>&1; then
  xattr -dr com.apple.quarantine "$APP" >/dev/null 2>&1 || true
fi

if [ ! -f "$AGENT" ] || [ ! -f "$INSTALLER" ]; then
  # An app-only build (no Go agent bundled). Not fatal: the viewer works, and
  # failing the whole install would be worse than lacking the host daemon.
  log "daemon dir exists but is incomplete: agent=$([ -f "$AGENT" ] && echo yes || echo no) installer=$([ -f "$INSTALLER" ] && echo yes || echo no)"
  exit 0
fi

chmod 755 "$AGENT" "$INSTALLER" 2>/dev/null || true

# Hand off to the SAME installer the Settings action uses, rather than a second
# copy of its logic that could drift from it.
if bash "$INSTALLER" "$AGENT" >>"$LOG" 2>&1; then
  log "daemon installed"
else
  # Never fail the package for this: the app itself is installed and usable as a
  # viewer, and a failed install is far more confusing than a missing daemon.
  log "daemon install FAILED (see above) — app still installed"
fi

exit 0
